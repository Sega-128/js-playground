PORT=3000
NODE_ENV=dev
SESSION_SECRET=change-me-to-a-long-random-string
FRONTEND_URL=http://localhost:3000

# MySQL. Use DB_HOST=mysql inside the dev container and DB_HOST=localhost outside it.
DB_HOST=mysql
DB_PORT=3306
DB_USER=myuser
DB_PASSWORD=mypassword
DB_NAME=bestdb_layered

# Used only by npm run db:init
DB_ROOT_USER=root
DB_ROOT_PASSWORD=
